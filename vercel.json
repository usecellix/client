{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://api.usecellix.com/api/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.usecellix.com/:path*"
    }
  ]
}
