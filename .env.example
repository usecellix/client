# Copy this file to .env (local dev) and fill in real values. .env and
# .env.production are both gitignored — never commit real values.

# Backend API base. `/api` uses the Vite dev proxy (see vite.config.ts) to
# reach VITE_BACKEND_TARGET below. Production points directly at the
# deployed API instead (no proxy in a static build).
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api/* — the Server backend's local
# address. Use 127.0.0.1, not localhost: on Windows, localhost can resolve
# to the IPv6 ::1 while Server only binds the IPv4 wildcard, causing
# intermittent ECONNREFUSED.
VITE_BACKEND_TARGET=http://127.0.0.1:4001

# The marketing/landing site (CELLIX-landing-page) — required. No hardcoded
# fallback: getMarketingSiteUrl() in src/lib/apiConfig.ts throws if this is
# unset, since a missing value previously caused dev builds to silently
# fall back to the production URL. Office's displayDialogAsync also refuses
# non-HTTPS URLs, so this must be an HTTPS origin even in local dev.
#   Local dev:  https://localhost:5173  (Landing-page's dev server, HTTPS
#               via office-addin-dev-certs — see Landing-page/vite.config.ts)
#   Production: https://www.usecellix.com
VITE_MARKETING_SITE_URL=https://localhost:5173

# Remote tunnel (optional): point VITE_API_BASE_URL at your tunnel URL
# instead of /api when testing against a non-local backend.
# VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com

# OpenRouter — used by local dev/test scripts that call the LLM directly
# from the client, if any. Keep this a dev-only key with a low spend cap.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_HTTP_REFERER=https://cellix.local
