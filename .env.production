# Production environment for app.usecellix.com.
# This file is gitignored (.gitignore: .env, .env.local — Vite also treats
# .env.production specially, loaded automatically by `vite build`/`npm run build`).
# On Vercel, set the same var in the project's Environment Variables (Production
# scope) instead of relying on this file being deployed — Vercel does not read
# local .env.production from the repo unless it's committed, and this one isn't.

# The Nest backend, deployed separately at api.usecellix.com.
VITE_API_BASE_URL=https://api.usecellix.com

# The marketing/landing site (CELLIX-landing-page) — "Upgrade" and pricing
# links (getMarketingSiteUrl/getPricingPageUrl in src/lib/apiConfig.ts) send
# users here. Defaults to http://localhost:5173 if unset, so this MUST be set
# for production or those buttons will point at localhost. www.usecellix.com
# is canonical (matches CELLIX-landing-page/public/robots.txt's Sitemap line).
VITE_MARKETING_SITE_URL=https://www.usecellix.com
